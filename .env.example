# Copy to .env and fill in. .env is git-ignored. NEVER put exchange API keys here:
# keys live in the encrypted vault (`sentinel vault set binance.api_key`).

# Master password for the vault. Prefer the OS keyring or an interactive prompt;
# use this only for headless/Docker deployments, and protect the file (chmod 600).
SENTINEL_MASTER_PASSWORD=

# Where config/state/vault live (defaults shown).
SENTINEL_CONFIG=config/sentinel.yaml
SENTINEL_HOME=var

# Any config value can be overridden with SENTINEL__<SECTION>__<KEY>, for example:
# SENTINEL__RISK__MAX_DAILY_LOSS_PCT=0.02
# SENTINEL__LOGGING__LEVEL=DEBUG
